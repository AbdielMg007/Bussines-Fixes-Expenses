# Local PostgreSQL settings only. Copy this file to .env before running Compose.
POSTGRES_DB=runway
POSTGRES_USER=runway
POSTGRES_PASSWORD=runway-local-development-only
POSTGRES_PORT=5432

# Backend authentication. These values are safe for local development only.
DATABASE_URL=postgres://runway:runway-local-development-only@127.0.0.1:5432/runway?sslmode=disable
APP_ORIGIN=http://127.0.0.1:3000
SESSION_DURATION=24h
SESSION_COOKIE_SECURE=false
